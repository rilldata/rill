{
  "name": "web-mcp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Single-file MCP Apps widget that renders Rill charts inside Claude, ChatGPT and other MCP Apps hosts.",
  "scripts": {
    "build": "vite build && node scripts/check-size.mjs",
    "dev": "vite build --watch --mode development",
    "harness": "vite --open /harness/index.html",
    "generate:catalog": "node scripts/generate-flint-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@playwright/test": "^1.50.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.4",
    "tailwindcss": "^3.4.13",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.1",
    "web-common": "*"
  }
}
